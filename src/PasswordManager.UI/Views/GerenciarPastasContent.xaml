<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManager.UI.Views.GerenciarPastasContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:PasswordManager.Domain.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="380" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="PastasList"
                  Grid.Row="0"
                  Height="240"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:VaultFolder">
                    <Grid ColumnSpacing="8" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;"
                                      FontSize="14"
                                      Foreground="{ThemeResource PMAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Uid="GerenciarPastas_AcaoRenomear"
                                Style="{StaticResource PMIconButton}"
                                Click="OnRenameFolderClick">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2"
                                x:Uid="GerenciarPastas_AcaoExcluir"
                                Style="{StaticResource PMIconButton}"
                                Click="OnDeleteFolderClick">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource PMDangerBrush}" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Nova pasta -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBoxName"
                     x:Uid="GerenciarPastas_NomePasta"
                     Style="{StaticResource PMTextBoxStyle}"
                     MinWidth="0"
                     HorizontalAlignment="Stretch" />
            <Button Grid.Column="1"
                    x:Uid="GerenciarPastas_BtnAdicionar"
                    Style="{StaticResource PMButtonPrimary}"
                    Click="OnAddClick"
                    VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</UserControl>
