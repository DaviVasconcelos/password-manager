<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManager.UI.Views.GerenciarPastasContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="380" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FolderBoxName" Header="Nome da pasta" PlaceholderText="Digite um nome..." />

        <ListView Grid.Row="1" x:Name="PastasList" Height="220" DisplayMemberPath="Name" SelectionMode="Single" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Adicionar" Click="OnAddClick" />
            <Button Content="Renomear" Click="OnRenameClick" />
            <Button Content="Excluir" Click="OnDeleteClick" />
        </StackPanel>
    </Grid>
</UserControl>