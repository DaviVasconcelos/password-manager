<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManager.UI.Views.SettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,14,4">
        <StackPanel Width="400" Spacing="12">
            <!-- Segurança -->
            <TextBlock x:Uid="Settings_Seguranca" Style="{StaticResource PMSectionHeaderStyle}" />
            <ComboBox x:Uid="Settings_TempoInatividade"
                      Style="{StaticResource PMComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.OpcoesTimeoutAutoLock}"
                      SelectedItem="{x:Bind ViewModel.TimeoutAutoLockMinutes, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
            <ComboBox x:Uid="Settings_LimpezaClipboard"
                      Style="{StaticResource PMComboBoxStyle}"
                      ItemsSource="{x:Bind ViewModel.OpcoesLimpezaClipboard}"
                      SelectedItem="{x:Bind ViewModel.ClipboardCleanTimeSeconds, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />

            <Border Height="1"
                    Background="{ThemeResource PMBorderSubtleBrush}"
                    Margin="0,4,0,0" />

            <!-- Gerador de senha (padrões) -->
            <TextBlock x:Uid="Settings_GeradorSenha" Style="{StaticResource PMSectionHeaderStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="8"
                        Maximum="64"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.PasswordGeneratorLength, Mode=TwoWay}"
                        x:Uid="Settings_TamanhoSlider"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.TamanhoSenhaTexto, Mode=OneWay}"
                           Style="{StaticResource PMCaptionStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PMTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
            <ToggleSwitch x:Uid="Settings_Minusculas" IsOn="{x:Bind ViewModel.IncludeLowercase, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Maiusculas" IsOn="{x:Bind ViewModel.IncludeUppercase, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Numeros" IsOn="{x:Bind ViewModel.IncludeDigits, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Simbolos" IsOn="{x:Bind ViewModel.IncludeSymbols, Mode=TwoWay}" />

            <TextBlock Text="{x:Bind ViewModel.Erro, Mode=OneWay}"
                       Foreground="{ThemeResource PMDangerBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
