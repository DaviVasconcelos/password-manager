<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PasswordManager.UI.Views.SettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="380" Spacing="12" Padding="0,4">
            <TextBlock x:Uid="Settings_AutoLock" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="Settings_AutoLock_Descricao" TextWrapping="Wrap" />
            <ComboBox x:Uid="Settings_TempoInatividade"
                      ItemsSource="{x:Bind ViewModel.OpcoesTimeoutAutoLock}"
                      SelectedItem="{x:Bind ViewModel.TimeoutAutoLockMinutes, Mode=TwoWay}" />

            <TextBlock x:Uid="Settings_Clipboard" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="Settings_Clipboard_Descricao" TextWrapping="Wrap" />
            <ComboBox x:Uid="Settings_LimpezaClipboard"
                      ItemsSource="{x:Bind ViewModel.OpcoesLimpezaClipboard}"
                      SelectedItem="{x:Bind ViewModel.ClipboardCleanTimeSeconds, Mode=TwoWay}" />

            <TextBlock x:Uid="Settings_GeradorSenha" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="Settings_GeradorSenha_Descricao" TextWrapping="Wrap" />
            <ComboBox x:Uid="Settings_TamanhoSenha"
                      ItemsSource="{x:Bind ViewModel.OpcoesTamanhoSenha}"
                      SelectedItem="{x:Bind ViewModel.PasswordGeneratorLength, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Minusculas" IsOn="{x:Bind ViewModel.IncludeLowercase, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Maiusculas" IsOn="{x:Bind ViewModel.IncludeUppercase, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Numeros" IsOn="{x:Bind ViewModel.IncludeDigits, Mode=TwoWay}" />
            <ToggleSwitch x:Uid="Settings_Simbolos" IsOn="{x:Bind ViewModel.IncludeSymbols, Mode=TwoWay}" />

            <TextBlock Text="{x:Bind ViewModel.Erro, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>