<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.UI.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PasswordManager.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolParaVisibilidade" />
        <converters:BoolToVisibilityConverter x:Key="BoolInvertidoParaVisibilidade" Invert="True" />
    </Page.Resources>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Card central (como antes, sem coluna lateral) -->
        <Border Grid.Row="0"
                Width="400"
                Padding="{StaticResource PMPaddingCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PMSurfaceBrush}"
                BorderBrush="{ThemeResource PMBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="16">
                <!-- Logo + identidade -->
                <FontIcon Glyph="&#xE72E;"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="36"
                          Foreground="{ThemeResource PMAccentBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="UnlockPage_TituloApp"
                           Style="{StaticResource PMTituloStyle}"
                           Foreground="{ThemeResource PMTextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Uid="UnlockPage_Subtitulo"
                           Style="{StaticResource PMSubtituloStyle}"
                           Foreground="{ThemeResource PMTextSecondaryBrush}"
                           HorizontalAlignment="Center" />

                <!-- Modo (criar/desbloquear) -->
                <TextBlock Text="{x:Bind ViewModel.TituloModo, Mode=OneWay}"
                           Style="{StaticResource PMCorpoStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PMTextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <!-- Nome do novo cofre (visível ao criar) -->
                <TextBox x:Name="NovoNomeBox"
                         x:Uid="UnlockPage_NovoNomeBox"
                         Visibility="{x:Bind ViewModel.ModoCriar, Mode=OneWay, Converter={StaticResource BoolParaVisibilidade}}"
                         TextChanged="OnNovoNomeTextChanged" />

                <!-- Formulário -->
                <PasswordBox x:Name="SenhaMestraBox"
                             Style="{StaticResource PMPasswordBoxStyle}"
                             x:Uid="UnlockPage_SenhaMestraBox"
                             PasswordRevealMode="Peek"
                             KeyDown="OnSenhaKeyDown" />

                <PasswordBox x:Name="ConfirmacaoBox"
                             Style="{StaticResource PMPasswordBoxStyle}"
                             x:Uid="UnlockPage_ConfirmacaoBox"
                             PasswordRevealMode="Peek"
                             KeyDown="OnConfirmacaoKeyDown"
                             Visibility="{x:Bind ViewModel.ModoCriar, Mode=OneWay, Converter={StaticResource BoolParaVisibilidade}}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ErroTemValor, Mode=OneWay, Converter={StaticResource BoolParaVisibilidade}}">
                    <FontIcon Glyph="&#xE783;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Foreground="{ThemeResource PMDangerBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Erro, Mode=OneWay}"
                               Style="{StaticResource PMCaptionStyle}"
                               Foreground="{ThemeResource PMDangerBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Ações -->
                <Button x:Uid="UnlockPage_BtnDesbloquear"
                        Style="{StaticResource PMButtonPrimary}"
                        Command="{x:Bind ViewModel.UnlockCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"
                        Visibility="{x:Bind ViewModel.ModoCriar, Mode=OneWay, Converter={StaticResource BoolInvertidoParaVisibilidade}}" />

                <Button x:Uid="UnlockPage_BtnCriarCofre"
                        Style="{StaticResource PMButtonPrimary}"
                        Command="{x:Bind ViewModel.CreateCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"
                        Visibility="{x:Bind ViewModel.ModoCriar, Mode=OneWay, Converter={StaticResource BoolParaVisibilidade}}" />

                <Button x:Uid="UnlockPage_BtnImportarBackup"
                        Style="{StaticResource PMButtonSecondary}"
                        Click="OnImportarBackupClick"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.ModoCriar, Mode=OneWay, Converter={StaticResource BoolParaVisibilidade}}" />

                <ProgressRing IsActive="{x:Bind ViewModel.Ocupado, Mode=OneWay}"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Botão discreto no canto inferior direito — mostra cofre selecionado e abre o menu suspenso -->
        <Button x:Name="BtnVaultPicker"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource PMButtonSecondary}"
                Opacity="0.85"
                Padding="12,6"
                Margin="0,16,0,0"
                AutomationProperties.Name="Vault_picker">
            <Button.Content>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource PMTextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.NomeCofreSelecionado, Mode=OneWay, FallbackValue='vault-1'}"
                               Style="{StaticResource PMCaptionStyle}"
                               Foreground="{ThemeResource PMTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource PMTextSecondaryBrush}" />
                </StackPanel>
            </Button.Content>
            <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="False">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Background" Value="{ThemeResource PMSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource PMBorderSubtleBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Border Width="300"
                            Padding="16"
                            Background="{ThemeResource PMSurfaceBrush}"
                            CornerRadius="8">
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                            <TextBlock x:Uid="UnlockPage_ListaCofres.Header"
                                       Style="{StaticResource PMCorpoStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource PMTextPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <ListView x:Name="CofresListView"
                                      Grid.Row="1"
                                      MaxHeight="220"
                                      ItemsSource="{x:Bind ViewModel.Cofres, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.CofreSelecionado, Mode=TwoWay}"
                                      SelectionChanged="OnCofresSelectionChanged"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4" Spacing="2">
                                            <TextBlock Text="{Binding Nome}"
                                                       Style="{StaticResource PMCorpoStyle}"
                                                       Foreground="{ThemeResource PMTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Arquivo}"
                                                       Style="{StaticResource PMCaptionStyle}"
                                                       Foreground="{ThemeResource PMTextSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                                <Button x:Uid="UnlockPage_BtnNovoArquivo"
                                        Style="{StaticResource PMButtonSecondary}"
                                        Click="OnNovoArquivoClick"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button x:Uid="UnlockPage_BtnRenomear"
                                        Style="{StaticResource PMButtonSecondary}"
                                        Click="OnRenomearClick"
                                        HorizontalAlignment="Stretch" />
                                <Button x:Uid="UnlockPage_BtnExcluir"
                                        Style="{StaticResource PMButtonSecondary}"
                                        Click="OnExcluirClick"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Page>
