<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.UI.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PasswordManager.UI.Converters"
    xmlns:domain="using:PasswordManager.Domain.Entities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Page.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cofre de senhas" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Exportar..." Click="OnExportarClick" />
                <Button Content="Importar..." Click="OnImportarClick" />
                <Button Content="Configurações..." Click="OnConfiguracoesClick" />
                <Button Content="Trocar senha mestra..." Click="OnTrocarSenhaMestraClick" />
                <Button Content="Trancar" Command="{x:Bind ViewModel.LockCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{x:Bind ViewModel.TermoBusca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Buscar por título, usuário, URL, notas ou categoria..." />
            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.FolderOptions}"
                      SelectedItem="{x:Bind ViewModel.OpcaoPastaSelecionada, Mode=TwoWay}"
                      DisplayMemberPath="Nome"
                      VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Pastas..." Click="OnGerenciarPastasClick" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Novo item" Click="OnNovoItemClick" />
            <Button Content="Editar" IsEnabled="{x:Bind ViewModel.CanEditItem, Mode=OneWay}" Click="OnEditarItemClick" />
            <Button Content="Copiar senha" Command="{x:Bind ViewModel.CopiarSenhaCommand}" />
            <Button Content="Excluir" Command="{x:Bind ViewModel.RemoverItemCommand}" />
            <TextBlock Text="Senha copiada (área de transferência será limpa em 30 s)."
                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.SenhaCopiada, Mode=OneWay, Converter={StaticResource BoolParaVisibilidade}}" />
        </StackPanel>

        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.DisplayedItems}"
                  SelectedItem="{x:Bind ViewModel.ItemSelecionado, Mode=TwoWay}"
                  SelectionMode="Single"
                  DoubleTapped="OnItemDoubleTapped">
            <ListView.Header>
                <Grid ColumnSpacing="12" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Título" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Usuário" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Categoria" FontWeight="SemiBold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:VaultItem">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Username}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Category}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>