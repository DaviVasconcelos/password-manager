<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalador MSI para PasswordManager (WinUI 3 unpackaged).

  Fluxo UI (WixUI_InstallDir_Custom):
    1) LanguageSelectionDlg - seleção de idioma (pt-BR / en-US)
    2) WelcomeDlg
    3) LicenseAgreementDlg
    4) InstallDirDlg - escolha da pasta (WIXUI_INSTALLDIR = INSTALLFOLDER)
    5) VerifyReadyDlg_Custom - checkbox opcional "Criar atalho na área de trabalho"
    6) Progress / Exit

  Build (local):
    dotnet publish src/PasswordManager.UI -c Release -p:Platform=x64 -r win-x64 &#45;&#45;self-contained -o publish
    powershell -ExecutionPolicy Bypass -File installer/generate-AppFiles.ps1 -PublishDir publish -Output installer/AppFiles.wxs
    wix build -arch x64 -culture pt-BR -culture en-US -d PublishDir=publish -d MsiVersion=0.1.0 -o PasswordManager-0.1.0-x64.msi installer/Package.wxs installer/AppFiles.wxs installer/WixUI_Custom.wxs installer/LanguageSelectionDlg.wxs installer/VerifyReadyDlg_Custom.wxs -ext WixToolset.UI.wixext -loc installer/Loc/Strings_pt-BR.wxl -loc installer/Loc/Strings_en-US.wxl
    # CI injeta -d MsiVersion a partir da git tag (v0.1.0, v0.2.0...); sem -d usa fallback 0.1.0 abaixo.

  UpgradeCode é estável - não altere.
  Correções: ícone via AppWindow.SetIcon com Assets copiado; MSI com UI completa.
-->
<?ifndef MsiVersion?>
<?define MsiVersion = "0.1.0"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="!(loc.ProductName)"
           Version="$(var.MsiVersion)"
           Manufacturer="!(loc.Manufacturer)"
           UpgradeCode="DA5FDCB9-00C2-4650-9224-0625EBD58AB1"
           Language="1033"
           Codepage="1252"
           Scope="perMachine">

    <SummaryInformation Keywords="PasswordManager" Description="!(loc.PackageDescription)" Manufacturer="!(loc.Manufacturer)" />

    <MajorUpgrade DowngradeErrorMessage="!(loc.MajorUpgradeDowngradeError)" />

    <Media Id="1" Cabinet="PasswordManager.cab" EmbedCab="yes" />

    <!-- Propriedades de UI -->
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" />
    <Property Id="INSTALLER_LANGUAGE" Value="pt-BR" Secure="yes" />

    <!-- UI custom: LanguageSelectionDlg + VerifyReady com checkbox desktop -->
    <ui:WixUI Id="WixUI_InstallDir_Custom" InstallDirectory="INSTALLFOLDER" />

    <!-- ESTRUTURA DE DIRETÓRIOS -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PasswordManager" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="PasswordManager" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- FEATURES -->
    <Feature Id="ProductFeature" Title="!(loc.ProductName)" Level="1" Description="!(loc.ProductFeatureDescription)" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="DesktopShortcutFeature" Title="!(loc.DesktopFeatureTitle)" Description="!(loc.DesktopFeatureDescription)" Level="1">
      <Level Value="0" Condition="NOT CREATE_DESKTOP_SHORTCUT" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Atalho no Menu Iniciar (sempre) -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuDir" Guid="B43AD99D-12E0-4698-85B3-6B1C711B766C">
      <Shortcut Id="StartMenuShortcut" Name="!(loc.ShortcutName)" Description="!(loc.ShortcutDescription)"
                Target="[INSTALLFOLDER]PasswordManager.UI.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.exe" />
      <RegistryValue Root="HKCU" Key="Software\PasswordManager" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="CleanUpShortCut" Directory="ProgramMenuDir" On="uninstall" />
    </Component>

    <!-- Atalho na Área de Trabalho (opcional) -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="C43AD99D-12E0-4698-85B3-6B1C711B766D">
      <Shortcut Id="DesktopShortcut" Name="!(loc.ShortcutName)" Description="!(loc.ShortcutDescription)"
                Target="[INSTALLFOLDER]PasswordManager.UI.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.exe" />
      <RegistryValue Root="HKCU" Key="Software\PasswordManager" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Icon Id="AppIcon.exe" SourceFile="src\PasswordManager.UI\Assets\logo-password-manager.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/DaviVasconcelos/password-manager" />

  </Package>
</Wix>
